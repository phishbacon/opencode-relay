# The browser-facing origin must be the same origin users use for OpenCode.
OPENCODE_RELAY_PUBLIC_URL=https://ai.example.com
# The container uses host networking so it can reach a loopback-only OpenCode server.
OPENCODE_RELAY_UPSTREAM_URL=http://127.0.0.1:4096
OPENCODE_RELAY_VAPID_SUBJECT=mailto:admin@example.com
# Generate a private random value of at least 32 characters; the OpenCode plugin uses the same value.
OPENCODE_RELAY_TOKEN=replace-with-at-least-32-random-characters
OPENCODE_RELAY_IMAGE=opencode-relay:0.1.0-experimental
# Relay itself binds this port only on host loopback.
OPENCODE_RELAY_PORT=8080
